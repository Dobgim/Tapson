# Supabase project settings -> API
# The anon key is public by design; Row Level Security is what protects data.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Never commit this one, and never prefix it with NEXT_PUBLIC_.
# Only needed if you run scripts/apply-sql.mjs to push schema from the CLI.
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Web3Forms access key — Dashboard -> your form -> Access Key.
# Server-only: never prefix with NEXT_PUBLIC_, or it becomes public and
# anyone can send mail through your form quota.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=<access-key>
